[Unit]
Description=CI-OS app-user daily runner
After=network.target

[Service]
Type=oneshot
User=cios
Group=cios
SupplementaryGroups=hermes
WorkingDirectory=/root/.hermes/apps/cios
Environment=CIOS_APP_DIR=/root/.hermes/apps/cios
Environment=CIOS_PUBLIC_DIR=/root/.hermes/apps/algolia-competitive-intelligence/apps/dashboard/public
ExecStart=/root/.hermes/apps/cios/deploy/cios-host-runner.sh
NoNewPrivileges=true
PrivateTmp=false
UMask=0007
